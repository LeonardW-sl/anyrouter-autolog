# AnyRouter 账号配置
ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

# agentrouter 账号：没有签到接口，靠重放 GitHub OAuth 登录触发签到
# github_cookie 用 env: 间接引用，真实凭据写在下面的 GH_SESSION_x 里
# ANYROUTER_ACCOUNTS=[{"name":"AG1","provider":"agentrouter","api_user":"你的api_user值","github_cookie":"env:GH_SESSION_1"}]

# GitHub 的 user_session cookie（F12 → Application → Cookies → github.com）
# 注意：等价于 GitHub 账号本身，两周有效期且每次使用滚动续期
# GH_SESSION_1=
# GH_SESSION_2=

# 可选：账号之间的等待秒数，站点按出口 IP 对登录限流（默认 75）
# ACCOUNT_INTERVAL_SECONDS=75

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# EMAIL_SENDER=
# PUSHPLUS_TOKEN=your_pushplus_token
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 想让两个站点推给不同的飞书机器人，就分别配下面两个；留空则都用上面那个共用的
# FEISHU_WEBHOOK_ANYROUTER=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_WEBHOOK_AGENTROUTER=https://open.feishu.cn/open-apis/bot/v2/hook/yyy
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# GOTIFY_URL=https://your-gotify-server/message
# GOTIFY_TOKEN=your_gotify_token
# GOTIFY_PRIORITY=9
